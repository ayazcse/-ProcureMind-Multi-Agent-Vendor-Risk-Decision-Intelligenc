# ============================================================
# ProcureMind Environment Configuration
# Copy this file to ".env" and fill in your values.
# ============================================================

# --- Database ---
# Default uses local SQLite (zero setup). To use PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/procuremind
DATABASE_URL=sqlite:///./procuremind.db

# --- LLM Provider ---
# Set LLM_PROVIDER to "anthropic", "openai", or "none".
# "none" (default if no key is set) runs ProcureMind in fully deterministic
# mode: rule-based extraction, statistical RAG retrieval, and explainable
# rule-based agent reasoning. No internet/API calls are made.
#
# Add a key below and set LLM_PROVIDER to activate real LLM-generated
# narrative explanations, nuanced compliance reasoning, and natural-language
# recommendations from the Decision Intelligence Agent. No code changes
# needed — just add the key, save, and restart the backend.
LLM_PROVIDER=none

# Anthropic (Claude) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (GPT) — get a key at https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# --- App ---
APP_ENV=development
SECRET_KEY=change_this_to_a_random_string_in_production
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
